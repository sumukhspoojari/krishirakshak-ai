# =============================================================================
# KrishiRakshak AI - Backend Environment Variables
# =============================================================================

# Groq Cloud API Key (Get free key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Database URL:
# For Local Development (SQLite):
# DATABASE_URL=sqlite:///./krishiai.db
# For Production (Supabase PostgreSQL):
# DATABASE_URL=postgresql://postgres.your_project:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./krishiai.db

# OpenWeatherMap API Key (Optional for real-time live weather advisories)
OPENWEATHER_API_KEY=

# Production Frontend Allowed Origins (Comma-separated)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Demo Mode (true enables offline mock responses if API keys are not supplied)
DEMO_MODE=true
